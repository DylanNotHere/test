
--==================================================
-- VANTA | MULTI-TARGET BERRY HARVESTER v2.0
-- HEARTBEAT GLIDE + 12-HIT MULTI-BURST + SNAKE SWEEP
--==================================================

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local HarvestRemote = RS:WaitForChild("Remotes"):WaitForChild("RequestHarvest")

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "VANTA | Berry Harvester",
    loadingTitle = "VANTA",
    loadingSubtitle = "Multi-Burst v2.0",
})

local Tab = Window:CreateTab({ name = "Farm" })

local CFG = {
    GlideSpeed = 40,
    HoverHeight = 3,
    GlideTimeout = 10,

    HarvestRange = 14,
    MoveDistance = 6,

    BurstAmount = 12,
    BurstDelay = 0.05,
    RefireDelay = 0.1,

    PortalPos = Vector3.new(3044.90649, 209.518799, -17.9989929),
    AvoidRadius = 20,
}

local enabled = false
local freefallWasEnabled = true

--==================================================
-- CHARACTER
--==================================================

local function getChar()
    local char = player.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if hum and root and hum.Health > 0 then
        return hum, root
    end
end

--==================================================
-- PORTAL CHECK
--==================================================

local function isNearPortal(pos)
    local flatPos = Vector3.new(pos.X, 0, pos.Z)
    local flatPortal = Vector3.new(
        CFG.PortalPos.X,
        0,
        CFG.PortalPos.Z
    )

    return (flatPos - flatPortal).Magnitude < CFG.AvoidRadius
end

--==================================================
-- ISLAND NODES
--==================================================

local function getNodesFolder()
    local fallback

    for _, island in ipairs(workspace:GetChildren()) do
        if island.Name:match("^Island_") then
            local nodes = island:FindFirstChild("Nodes")

            if nodes then
                if island.Name:find(tostring(player.UserId), 1, true) then
                    return nodes
                end

                fallback = fallback or nodes
            end
        end
    end

    return fallback
end

--==================================================
-- HEARTBEAT GLIDE
-- Uses the movement style from your Slime Farmer
--==================================================

local function glideTo(hum, root, destination)
    if not enabled or not root.Parent or hum.Health <= 0 then
        return false
    end

    local startTime = os.clock()
    local targetPos = destination + Vector3.new(0, CFG.HoverHeight, 0)

    freefallWasEnabled = true
    hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)

    while enabled
        and root.Parent
        and hum.Health > 0
        and os.clock() - startTime < CFG.GlideTimeout do

        local offset = targetPos - root.Position

        if offset.Magnitude <= 4 then
            hum:Move(Vector3.zero, false)
            root.AssemblyLinearVelocity = Vector3.zero
            return true
        end

        local dt = RunService.Heartbeat:Wait()

        if not enabled or not root.Parent then
            break
        end

        offset = targetPos - root.Position

        if offset.Magnitude > 0.05 then
            local step = math.min(CFG.GlideSpeed * dt, offset.Magnitude)
            root.CFrame = root.CFrame + offset.Unit * step
        end

        root.AssemblyLinearVelocity = Vector3.zero

        local flat = Vector3.new(offset.X, 0, offset.Z)
        hum:Move(
            flat.Magnitude > 1 and flat.Unit or Vector3.zero,
            false
        )

        if hum:GetState() == Enum.HumanoidStateType.Freefall then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end

    hum:Move(Vector3.zero, false)
    return false
end

local function restoreMovement()
    local hum = getChar()

    if hum then
        hum:Move(Vector3.zero, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
    end
end

--==================================================
-- BUILD SNAKE GRID
--==================================================

local function getTargets(nodes)
    local rows = {}

    for _, node in ipairs(nodes:GetChildren()) do
        if node.Name == "BerryBush"
            and node:FindFirstChild("Berries") then

            local hb = node:FindFirstChild("HB")

            if hb and hb:IsA("BasePart") and not isNearPortal(hb.Position) then
                local z = math.floor(hb.Position.Z / 4) * 4

                rows[z] = rows[z] or {}
                table.insert(rows[z], hb)
            end
        end
    end

    local zKeys = {}

    for z in pairs(rows) do
        table.insert(zKeys, z)
    end

    table.sort(zKeys)

    local targets = {}

    for i, z in ipairs(zKeys) do
        local row = rows[z]

        table.sort(row, function(a, b)
            if i % 2 == 1 then
                return a.Position.X < b.Position.X
            end

            return a.Position.X > b.Position.X
        end)

        for _, hb in ipairs(row) do
            table.insert(targets, hb)
        end
    end

    return targets
end

--==================================================
-- MULTI-TARGET BURST
-- Sends one request to every bush per round
--==================================================

local function burstCluster(cluster)
    local valid = {}

    for _, hb in ipairs(cluster) do
        if hb and hb.Parent then
            table.insert(valid, hb)
        end
    end

    for hit = 1, CFG.BurstAmount do
        if not enabled then
            break
        end

        local fired = 0

        for _, hb in ipairs(valid) do
            if not enabled then
                break
            end

            if hb and hb.Parent then
                HarvestRemote:FireServer(hb)
                fired += 1
            end
        end

        if fired == 0 then
            break
        end

        if hit < CFG.BurstAmount then
            task.wait(CFG.BurstDelay)
        end
    end

    task.wait(CFG.RefireDelay)
end

--==================================================
-- HARVEST LOOP
--==================================================

local function harvestLoop()
    while enabled do
        local hum, root = getChar()
        local nodes = getNodesFolder()

        if hum and root and nodes then
            local targets = getTargets(nodes)
            local processed = {}
            local currentIndex = 1

            while currentIndex <= #targets and enabled do
                hum, root = getChar()

                if not hum or not root then
                    break
                end

                local primaryHB = targets[currentIndex]

                if not primaryHB
                    or not primaryHB.Parent
                    or processed[primaryHB]
                    or isNearPortal(primaryHB.Position) then

                    currentIndex += 1
                    continue
                end

                -- Move to the next snake target
                local arrived = glideTo(hum, root, primaryHB.Position)

                if not enabled then
                    break
                end

                if not arrived then
                    -- Avoid getting stuck on unreachable targets
                    processed[primaryHB] = true
                    currentIndex += 1
                    continue
                end

                -- Collect every unprocessed bush in range
                local cluster = {}

                for _, checkHB in ipairs(targets) do
                    if checkHB
                        and checkHB.Parent
                        and not processed[checkHB]
                        and not isNearPortal(checkHB.Position)
                        and (checkHB.Position - primaryHB.Position).Magnitude
                            <= CFG.HarvestRange then

                        table.insert(cluster, checkHB)
                    end
                end

                if #cluster > 0 then
                    -- Mark before firing so targets aren't repeated
                    for _, hb in ipairs(cluster) do
                        processed[hb] = true
                    end

                    burstCluster(cluster)
                else
                    processed[primaryHB] = true
                end

                currentIndex += 1
            end
        end

        task.wait(0.5)
    end

    restoreMovement()
end

--==================================================
-- UI
--==================================================

Tab:CreateToggle({
    name = "Auto Harvest (Multi-Burst)",
    flag = "AutoHarvest",
    currentValue = false,

    callback = function(on)
        enabled = on

        if on then
            task.spawn(harvestLoop)
        else
            restoreMovement()
        end
    end,
})

Tab:CreateSlider({
    name = "Burst Amount",
    flag = "BurstAmount",
    range = {1, 20},
    increment = 1,
    suffix = " hits",
    currentValue = CFG.BurstAmount,

    callback = function(v)
        CFG.BurstAmount = v
    end,
})

Tab:CreateSlider({
    name = "Burst Delay",
    flag = "BurstDelay",
    range = {0.01, 0.5},
    increment = 0.01,
    suffix = " s",
    currentValue = CFG.BurstDelay,

    callback = function(v)
        CFG.BurstDelay = v
    end,
})

Tab:CreateSlider({
    name = "Harvest Range",
    flag = "HarvestRange",
    range = {5, 25},
    increment = 1,
    suffix = " studs",
    currentValue = CFG.HarvestRange,

    callback = function(v)
        CFG.HarvestRange = v
    end,
})

Tab:CreateSlider({
    name = "Glide Speed",
    flag = "GlideSpeed",
    range = {10, 100},
    increment = 5,
    suffix = "",
    currentValue = CFG.GlideSpeed,

    callback = function(v)
        CFG.GlideSpeed = v
    end,
})

Tab:CreateSlider({
    name = "Hover Height",
    flag = "HoverHeight",
    range = {1, 15},
    increment = 1,
    suffix = " studs",
    currentValue = CFG.HoverHeight,

    callback = function(v)
        CFG.HoverHeight = v
    end,
})
