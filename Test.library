-- berryharvest_v1.0.0
-- Sweeps your berry field in long lanes, gliding at the berry farm's speed without ever stopping, and harvests
-- every ready bush within range as it passes. When it has covered the whole field it starts over (bushes regrow).
-- Harvest call: RequestHarvest:FireServer(bush.HB)  (from the Cobalt capture)

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

-- send both lowercase and Capitalised keys so either UI style works
local function dual(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
		out[k:sub(1, 1):upper() .. k:sub(2)] = v
	end
	return out
end

local Window = Rayfield:CreateWindow(dual({
	name = "VANTA | Berry Harvest",
	loadingTitle = "VANTA",
	loadingSubtitle = "Smooth lane sweep",
}))
local Tab = Window:CreateTab(dual({ name = "Harvest" }))

local CFG = {
	Range = 18,         -- studs: bushes within this distance of you get harvested
	HarvestRate = 40,   -- harvest requests per second (slider)
	Burst = 4,          -- requests per tick
	GlideSpeed = 30,    -- studs per second (same as the berry farm)
	HoverHeight = 7,    -- studs above the bushes
	LaneSpacing = 26,   -- distance between lanes (a bit under 2 x Range so every bush is covered)
	Retry = 1.5,        -- seconds before the same bush is tried again
	MaxTries = 3,       -- tries before a bush is left alone for a while
	SkipFor = 30,       -- seconds to leave a stubborn bush alone
	RegrowTime = 60,    -- only used if the bush state can't be read (timer mode)
}

local function notify(title, content)
	pcall(function()
		Rayfield:Notify(dual({ title = title, content = content, duration = 4 }))
	end)
end

-- ===== bushes (cached, with a grid so range checks stay cheap) =====
local bushes = {}   -- [node] = entry
local grid = {}     -- ["gx,gz"] = { entries }
local conns = {}
local cell = CFG.Range

local function cellOf(pos)
	return math.floor(pos.X / cell), math.floor(pos.Z / cell)
end

local function findNodes()
	local fallback
	for _, c in ipairs(workspace:GetChildren()) do
		if c.Name:match("^Island_") then
			local n = c:FindFirstChild("Nodes")
			if n then
				if c.Name:find(tostring(player.UserId), 1, true) then return n end
				fallback = fallback or n
			end
		end
	end
	return fallback
end

local function addBush(node)
	if bushes[node] or not node.Name:find("Berry", 1, true) then return end
	local hb = node:FindFirstChild("HB") or node:WaitForChild("HB", 3)
	if not hb or bushes[node] then return end
	local e = { node = node, hb = hb, berries = node:FindFirstChild("Berries"), nextTry = 0, tries = 0, nextReady = 0 }
	e.gx, e.gz = cellOf(hb.Position)
	e.key = e.gx .. "," .. e.gz
	bushes[node] = e
	grid[e.key] = grid[e.key] or {}
	table.insert(grid[e.key], e)
end

local function removeBush(node)
	local e = bushes[node]
	if not e then return end
	bushes[node] = nil
	local list = grid[e.key]
	if list then
		for i, x in ipairs(list) do
			if x == e then
				table.remove(list, i)
				break
			end
		end
	end
end

-- ===== is a bush ready? =====
local visualWorks = true -- false = the berries' look doesn't change, so we fall back to a timer

local function isReady(e)
	if not visualWorks then
		return os.clock() >= e.nextReady
	end
	local b = e.berries
	if not b or not b.Parent then
		b = e.node:FindFirstChild("Berries")
		e.berries = b
	end
	if not b then return true end
	if b:IsA("BasePart") then
		return b.Transparency < 0.95
	end
	for _, p in ipairs(b:GetChildren()) do
		if p:IsA("BasePart") and p.Transparency < 0.95 then return true end
	end
	return false
end

-- ===== harvesting =====
local Harvest = RS:WaitForChild("Remotes"):WaitForChild("RequestHarvest")
local fired, transitions = 0, 0

local function readyNear(pos, now)
	local out = {}
	local gx, gz = cellOf(pos)
	local r2 = CFG.Range * CFG.Range
	for dx = -1, 1 do
		for dz = -1, 1 do
			local list = grid[(gx + dx) .. "," .. (gz + dz)]
			if list then
				for _, e in ipairs(list) do
					local hb = e.hb
					if hb.Parent then
						local d = hb.Position - pos
						local d2 = d.X * d.X + d.Y * d.Y + d.Z * d.Z
						if d2 <= r2 then
							if isReady(e) then
								if now >= e.nextTry then
									out[#out + 1] = { e = e, d2 = d2 }
								end
							elseif e.tries > 0 then
								e.tries = 0 -- it was harvested
								transitions += 1
							end
						end
					end
				end
			end
		end
	end
	table.sort(out, function(a, b) return a.d2 < b.d2 end)
	return out
end

local function harvestTick(pos, now)
	local list = readyNear(pos, now)
	for i = 1, math.min(#list, CFG.Burst) do
		local e = list[i].e
		Harvest:FireServer(e.hb)
		fired += 1
		e.tries += 1
		if e.tries >= CFG.MaxTries then
			e.nextTry = now + CFG.SkipFor
			e.tries = 0
		else
			e.nextTry = now + CFG.Retry
		end
		if not visualWorks then
			e.nextReady = now + CFG.RegrowTime
		end
	end

	-- if bushes never look different after being harvested, stop trusting how they look
	if visualWorks and fired >= 200 and transitions == 0 then
		visualWorks = false
		warn("[Harvest] can't tell when a bush is ready from how it looks; using a " .. CFG.RegrowTime .. "s timer per bush")
		notify("Timer mode", "Couldn't read the bush state, using a timer per bush.")
	end
end

-- ===== moving: glide + hover =====
local function getChar()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		return hum, root
	end
end

local hoverCF, hoverConn

local function startHover(hum, root)
	if hoverConn then return end
	hoverCF = root.CFrame
	hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false) -- no falling pose while hovering
	hoverConn = RunService.Heartbeat:Connect(function()
		if root.Parent then
			root.CFrame = hoverCF -- hold position so you don't drop between moves
			root.AssemblyLinearVelocity = Vector3.zero
			if hum:GetState() == Enum.HumanoidStateType.Freefall then
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
		end
	end)
end

local function stopHover()
	if hoverConn then
		hoverConn:Disconnect()
		hoverConn = nil
	end
	hoverCF = nil
	local hum = getChar()
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
		hum:Move(Vector3.zero, false)
	end
end

local Enabled = false
local RunId = 0

local function active(run)
	return Enabled and run == RunId
end

-- glide to `goal`, harvesting as we go (the harvest ticks are timed, not tied to stopping anywhere)
local function moveTo(goal, run)
	local hum, root = getChar()
	if not hum then return false end
	startHover(hum, root)

	local lastTick = 0
	while active(run) do
		if hum.Health <= 0 then return false end
		local d = goal - hoverCF.Position
		if d.Magnitude <= 1 then break end

		local dt = RunService.Heartbeat:Wait()
		hoverCF = hoverCF + d.Unit * math.min(CFG.GlideSpeed * dt, d.Magnitude)

		local flat = Vector3.new(d.X, 0, d.Z) -- plays the walking animation while gliding
		hum:Move(flat.Magnitude > 1 and flat.Unit or Vector3.zero, false)

		local now = os.clock()
		if now - lastTick >= CFG.Burst / CFG.HarvestRate then
			lastTick = now
			harvestTick(hoverCF.Position, now)
		end
	end

	hum:Move(Vector3.zero, false)
	return true
end

-- ===== the sweep: lanes across the whole field =====
local function planLanes()
	local minZ, maxZ, sumY, n = math.huge, -math.huge, 0, 0
	for _, e in pairs(bushes) do
		if e.hb.Parent then
			local p = e.hb.Position
			minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
			sumY += p.Y
			n += 1
		end
	end
	if n == 0 then return nil end

	local lanes, half = {}, CFG.LaneSpacing / 2
	local z = minZ + half
	while z - half <= maxZ do
		local lo, hi = math.huge, -math.huge
		for _, e in pairs(bushes) do
			if e.hb.Parent then
				local p = e.hb.Position
				if math.abs(p.Z - z) <= half then
					lo, hi = math.min(lo, p.X), math.max(hi, p.X)
				end
			end
		end
		if hi > lo then
			lanes[#lanes + 1] = { z = z, x0 = lo, x1 = hi }
		end
		z += CFG.LaneSpacing
	end
	return lanes, sumY / n + CFG.HoverHeight, n
end

local function sweepLoop(run)
	local sweeps = 0
	while active(run) do
		local hum = getChar()
		if not hum then
			task.wait(1) -- dead or respawning
		else
			local lanes, y, n = planLanes()
			if not lanes or #lanes == 0 then
				warn("[Harvest] no berry bushes found on your island")
				notify("No bushes found", "Couldn't find any BerryBush in your island's Nodes folder.")
				break
			end

			local before = fired
			sweeps += 1
			local forward = true
			for _, lane in ipairs(lanes) do
				if not active(run) then break end
				local a, b = lane.x0, lane.x1
				if not forward then a, b = b, a end
				forward = not forward
				if not moveTo(Vector3.new(a, y, lane.z), run) then break end
				if not moveTo(Vector3.new(b, y, lane.z), run) then break end
			end

			print(("[Harvest] sweep %d done: %d requests (%d bushes in the field)"):format(sweeps, fired - before, n))
			if fired - before < 5 and active(run) then
				-- nothing was ready: rest instead of gliding around for nothing
				stopHover()
				task.wait(10)
			end
		end
		task.wait()
	end
	stopHover()
end

-- ===== arming =====
local function arm()
	local nodes = findNodes()
	if not nodes then
		warn("[Harvest] couldn't find your island's Nodes folder")
		return false
	end
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
	bushes, grid = {}, {}

	for _, n in ipairs(nodes:GetChildren()) do
		task.spawn(addBush, n)
	end
	table.insert(conns, nodes.ChildAdded:Connect(function(n) task.spawn(addBush, n) end))
	table.insert(conns, nodes.ChildRemoved:Connect(removeBush))

	-- wait until the bush list stops growing (thousands of bushes take a moment to register)
	local last = -1
	for _ = 1, 25 do
		task.wait(0.15)
		local c = 0
		for _ in pairs(bushes) do c += 1 end
		if c > 0 and c == last then break end
		last = c
	end

	local count, ready = 0, 0
	for _, e in pairs(bushes) do
		count += 1
		if isReady(e) then ready += 1 end
	end
	print(("[Harvest] %d bushes found, %d look ready right now"):format(count, ready))
	return count > 0
end

-- ===== UI =====
Tab:CreateToggle(dual({
	name = "Auto Harvest",
	flag = "AutoHarvest",
	currentValue = false,
	callback = function(on)
		Enabled = on
		RunId += 1
		if on then
			if arm() then
				notify("Auto Harvest on", "Sweeping the field.")
				task.spawn(sweepLoop, RunId)
			else
				notify("No bushes found", "Couldn't find berry bushes on your island.")
			end
		else
			notify("Auto Harvest off", "Stopped.")
		end
	end,
}))

pcall(function()
	Tab:CreateSlider(dual({
		name = "Harvest Speed (per second)",
		flag = "HarvestRate",
		range = { 5, 100 },
		increment = 5,
		suffix = "/s",
		currentValue = CFG.HarvestRate,
		callback = function(v) CFG.HarvestRate = v end,
	}))
end)

notify("VANTA Berry Harvest", "Loaded. Turn Auto Harvest on.")
