-- ==================================================
-- VANTA | BERRY PLANTER (Perfect Snake Pattern)
-- ==================================================
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local function dual(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
		out[k:sub(1, 1):upper() .. k:sub(2)] = v
	end
	return out
end

local Window = Rayfield:CreateWindow(dual({
	name = "VANTA | Berry Planter",
	loadingTitle = "VANTA",
	loadingSubtitle = "Snake Pattern",
}))
local Tab = Window:CreateTab(dual({ name = "Planter" }))

local CFG = {
	SeedType = "BerryBushSeed", 
	PlaceDelay = 0.04,
	MaxDelay = 1.0,
	CheckTimeout = 3,
	MaxRetries = 4,
	GlideSpeed = 45,
	HoverHeight = 4,
}

local FIXED_NORMAL = Vector3.new(0, 1, 0)
local KEY_PATTERN = "^(-?%d+),(-?%d+),(-?%d+)$"

local function fmt(x, y, z) return string.format("%d,%d,%d", x, y, z) end
local function notify(title, content) pcall(function() Window:Notify(dual({ title = title, content = content, duration = 4 })) end) end

-- ===== STATE =====
local Enabled = false
local RunId = 0
local BlocksFolder, occupied, blockKey, conns = nil, {}, {}, {}

local function findBlocksFolder()
	local fallback
	for _, island in ipairs(workspace:GetChildren()) do
		if island.Name:match("^Island_") then
			local blocks = island:FindFirstChild("Blocks")
			if blocks then
				if island.Name:find(tostring(player.UserId), 1, true) then return blocks end
				fallback = fallback or blocks
			end
		end
	end
	return fallback
end

local function register(block)
	local key = block:GetAttribute("CellKey")
	if key then occupied[key] = block; blockKey[block] = key; return end
	local conn = block:GetAttributeChangedSignal("CellKey"):Connect(function()
		local k = block:GetAttribute("CellKey")
		if k then occupied[k] = block; blockKey[block] = k; conn:Disconnect() end
	end)
	task.delay(3, function() if conn.Connected then conn:Disconnect() end end)
end

local function blockPos(b) return b:IsA("BasePart") and b.Position or b:GetPivot().Position end

local function getChar()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then return hum, root end
end

local hoverCF, hoverConn
local function startHover(hum, root)
	if hoverConn then return end
	hoverCF = root.CFrame
	hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
	hoverConn = RunService.Heartbeat:Connect(function()
		if root.Parent then
			root.CFrame = hoverCF
			root.AssemblyLinearVelocity = Vector3.zero
			if hum:GetState() == Enum.HumanoidStateType.Freefall then
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
		end
	end)
end

local function stopHover()
	if hoverConn then hoverConn:Disconnect(); hoverConn = nil end
	hoverCF = nil
	local hum = getChar()
	if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true); hum:Move(Vector3.zero, false) end
end

local function glideActive(goal, active)
	local hum, root = getChar()
	if not hum then return false end
	startHover(hum, root)
	while active() do
		if hum.Health <= 0 then return false end
		local d = goal - hoverCF.Position
		if d.Magnitude <= 0.75 then break end
		local dt = RunService.Heartbeat:Wait()
		hoverCF = hoverCF + d.Unit * math.min(CFG.GlideSpeed * dt, d.Magnitude)
		local flat = Vector3.new(d.X, 0, d.Z)
		hum:Move(flat.Magnitude > 1 and flat.Unit or Vector3.zero, false)
	end
	hum:Move(Vector3.zero, false)
	return true
end

local function glideAbove(pos, offset, run)
	return glideActive(pos + Vector3.new(0, offset, 0), function() return Enabled and run == RunId end)
end

-- ===== PERFECT SNAKE PLANTER =====
local function plant(run)
	local Remote = RS:WaitForChild("Remotes"):WaitForChild("RequestPlace")
	
	-- Find all GrassBlocks and determine top layer
	local maxY = -math.huge
	for key, block in pairs(occupied) do
		if block:GetAttribute("BlockId") == "GrassBlock" then
			local _, y = key:match(KEY_PATTERN)
			y = tonumber(y)
			if y > maxY then maxY = y end
		end
	end

	if maxY == -math.huge then
		notify("Error", "No GrassBlocks found on island.")
		return
	end

	-- Collect all valid targets
	local targets = {}
	for key, block in pairs(occupied) do
		if block:GetAttribute("BlockId") == "GrassBlock" then
			local x, y, z = key:match(KEY_PATTERN)
			x, y, z = tonumber(x), tonumber(y), tonumber(z)
			if y == maxY then
				local targetKey = fmt(x, y + 1, z)
				if not occupied[targetKey] then
					table.insert(targets, { x = x, y = y + 1, z = z, key = targetKey, supportKey = key })
				end
			end
		end
	end

	if #targets == 0 then
		notify("Error", "No valid spots to plant.")
		return
	end

	-- Sort into a perfect snake pattern
	-- Group by Z, sort X ascending for even Z rows, descending for odd Z rows
	table.sort(targets, function(a, b)
		if a.z == b.z then
			if a.z % 2 == 0 then
				return a.x < b.x
			else
				return a.x > b.x
			end
		end
		return a.z < b.z
	end)

	notify("Planting", ("Found %d valid spots."):format(#targets))

	local delay = CFG.PlaceDelay
	local placedCount = 0

	for _, target in ipairs(targets) do
		if not Enabled or run ~= RunId then break end
		
		local supportBlock = occupied[target.supportKey]
		if supportBlock and supportBlock.Parent then
			glideAbove(blockPos(supportBlock), CFG.HoverHeight, run)

			local targetPos = { x = target.x, y = target.y, z = target.z }
			Remote:FireServer(targetPos, CFG.SeedType, 0, FIXED_NORMAL, false, nil, false, 5)

			local deadline = os.clock() + CFG.CheckTimeout
			while not occupied[target.key] and os.clock() < deadline and Enabled and run == RunId do task.wait(0.03) end
			
			if occupied[target.key] then
				placedCount = placedCount + 1
				delay = math.max(CFG.PlaceDelay, delay * 0.95)
			else
				delay = math.min(math.max(delay * 1.6, 0.15), CFG.MaxDelay)
			end
			task.wait(delay)
		end
	end
	notify("Planting Done", ("Placed %d seeds."):format(placedCount))
end

local function runPlant(run)
	pcall(plant, run)
	stopHover()
end

local function disconnectAll()
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
end

-- ===== UI =====
Tab:CreateToggle(dual({
	name = "Plant Seeds (Perfect Snake)",
	flag = "AutoPlanter",
	currentValue = false,
	callback = function(on)
		Enabled = on
		RunId += 1
		disconnectAll()
		if not on then stopHover(); return end
		
		BlocksFolder = findBlocksFolder()
		if not BlocksFolder then notify("Error", "No island found."); return end

		occupied, blockKey = {}, {}
		for _, block in ipairs(BlocksFolder:GetChildren()) do register(block) end

		local run = RunId
		table.insert(conns, BlocksFolder.ChildAdded:Connect(function(block) register(block) end))
		task.spawn(runPlant, run)
	end,
}))

Window:Notify(dual({ title = "VANTA Planter", content = "Loaded. Perfect snake enabled.", duration = 5 }))
