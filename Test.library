--==================================================
-- VANTA | AUTO POLLINATION v2.0 (simple)
-- No FlowerId / colour matching any more.
-- Finds every "Snapdragon Flower" on your island, pairs each one with the nearest other Snapdragon Flower
-- within 2 cells, then: teleport next to the pair -> pollinate both -> teleport to the next pair.
--==================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local HoldRemote = Remotes:WaitForChild("RequestHoldBlock")
local PollinateRemote = Remotes:WaitForChild("RequestPollinate")

--==================================================
-- CONFIGURATION
--==================================================

local CFG = {
    FlowerName = "snapdragonflower", -- compared lower-case with spaces removed, so "Snapdragon Flower" works too
    GridSize = 4,                    -- studs per cell
    MaxCells = 2,                    -- a pair = two flowers at most this many cells apart
    HeightTolerance = 2,

    TeleportHeight = 3,
    TeleportDelay = 0.12,            -- wait after each teleport
    PollinationDelay = 0.2,          -- wait after each pollination

    Loop = true,                     -- go round again when every pair is done
    LoopDelay = 3,
}

--==================================================
-- STATE
--==================================================

local Running = false
local Equipped = false
local Stats = { Pairs = 0, Done = 0, Rounds = 0 }

--==================================================
-- RAYFIELD
--==================================================

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "VANTA | Auto Pollination",
    LoadingTitle = "VANTA",
    LoadingSubtitle = "Snapdragons",
    Theme = "Default",
    DisableRayfieldPrompts = true,
})

local MainTab = Window:CreateTab("Main")
local SettingsTab = Window:CreateTab("Settings")

MainTab:CreateSection("Automation")

local StatusLabel = MainTab:CreateLabel("Status: Idle")
local StatsLabel = MainTab:CreateLabel("Pairs: 0 | Pollinated: 0 | Rounds: 0")

local function UpdateStatus(Message)
    StatusLabel:Set("Status: " .. Message)
end

local function UpdateStats()
    StatsLabel:Set(("Pairs: %d | Pollinated: %d | Rounds: %d"):format(Stats.Pairs, Stats.Done, Stats.Rounds))
end

--==================================================
-- CHARACTER + TELEPORT
--==================================================

local function GetRoot()
    local Character = Player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if Humanoid and Root and Humanoid.Health > 0 then
        return Root
    end

    return nil
end

local function WaitForRoot()
    local Root = GetRoot()

    while Running and not Root do
        UpdateStatus("Waiting for respawn...")
        Equipped = false
        task.wait(1)
        Root = GetRoot()
    end

    return Root
end

local function TeleportTo(Position)
    local Root = WaitForRoot()

    if not Root then
        return false
    end

    Root.CFrame = CFrame.new(Position.X, Position.Y + CFG.TeleportHeight, Position.Z)
    Root.AssemblyLinearVelocity = Vector3.zero

    task.wait(CFG.TeleportDelay)

    return true
end

--==================================================
-- ISLAND (the one you're standing next to; works on co-op islands too)
--==================================================

local function GetNodes()
    local Root = GetRoot()

    local Best, BestDistance, Fallback

    for _, Island in ipairs(workspace:GetChildren()) do
        if Island.Name:match("^Island_") then
            local Nodes = Island:FindFirstChild("Nodes")

            if Nodes then
                Fallback = Fallback or Nodes

                if Root then
                    local Kids = Nodes:GetChildren()
                    local Step = math.max(1, math.floor(#Kids / 12))

                    for Index = 1, #Kids, Step do
                        local HB = Kids[Index]:FindFirstChild("HB")

                        if HB and HB:IsA("BasePart") then
                            local Distance = (HB.Position - Root.Position).Magnitude

                            if not BestDistance or Distance < BestDistance then
                                Best, BestDistance = Nodes, Distance
                            end
                        end
                    end
                end
            end
        end
    end

    return Best or Fallback
end

--==================================================
-- FIND PAIRS
--==================================================

local function IsSnapdragon(Model)
    if not Model:IsA("Model") then
        return false
    end

    return Model.Name:lower():gsub("%s+", "") == CFG.FlowerName
end

local function FindPairs(Nodes)
    -- every snapdragon on the island
    local Flowers = {}

    for _, Object in ipairs(Nodes:GetDescendants()) do
        if IsSnapdragon(Object) then
            local HB = Object:FindFirstChild("HB", true)

            if HB and HB:IsA("BasePart") then
                Flowers[#Flowers + 1] = { Model = Object, HB = HB, Position = HB.Position }
            end
        end
    end

    -- pair each flower with the nearest unused one within MaxCells (in X and Z)
    local Reach = CFG.GridSize * CFG.MaxCells + 0.6
    local Used = {}
    local Pairs = {}

    for Index, A in ipairs(Flowers) do
        if not Used[A.Model] then
            local Best, BestDistance

            for OtherIndex, B in ipairs(Flowers) do
                if OtherIndex ~= Index and not Used[B.Model] then
                    local DX = math.abs(A.Position.X - B.Position.X)
                    local DZ = math.abs(A.Position.Z - B.Position.Z)
                    local DY = math.abs(A.Position.Y - B.Position.Y)

                    if DX <= Reach and DZ <= Reach and DY <= CFG.HeightTolerance then
                        local Distance = DX * DX + DZ * DZ

                        if Distance > 0 and (not BestDistance or Distance < BestDistance) then
                            Best, BestDistance = B, Distance
                        end
                    end
                end
            end

            if Best then
                Used[A.Model] = true
                Used[Best.Model] = true

                table.insert(Pairs, {
                    A = A,
                    B = Best,
                    Spot = (A.Position + Best.Position) / 2,
                })
            end
        end
    end

    -- visit them in a sensible order: always go to the closest pair next
    local Ordered = {}
    local Current = nil

    while #Pairs > 0 do
        local BestIndex, BestDistance = 1, nil

        for Index, Pair in ipairs(Pairs) do
            local Distance = Current and (Pair.Spot - Current).Magnitude or Pair.Spot.Magnitude

            if not BestDistance or Distance < BestDistance then
                BestIndex, BestDistance = Index, Distance
            end
        end

        local Pair = table.remove(Pairs, BestIndex)
        Ordered[#Ordered + 1] = Pair
        Current = Pair.Spot
    end

    return Ordered
end

--==================================================
-- POLLINATE
--==================================================

local function EquipPollinator()
    HoldRemote:FireServer("Pollinator")
    task.wait(CFG.PollinationDelay)
    Equipped = true
end

local function PollinatePair(Pair)
    if not (Pair.A.Model.Parent and Pair.B.Model.Parent and Pair.A.HB.Parent and Pair.B.HB.Parent) then
        return false -- one of them is gone
    end

    if not TeleportTo(Pair.Spot) then
        return false
    end

    PollinateRemote:FireServer(Pair.A.HB, 1)
    task.wait(CFG.PollinationDelay)

    PollinateRemote:FireServer(Pair.B.HB, 2)
    task.wait(CFG.PollinationDelay)

    Stats.Done += 1
    UpdateStats()

    return true
end

--==================================================
-- MAIN LOOP
--==================================================

local function Run()
    while Running do
        local Nodes = GetNodes()

        if not Nodes then
            UpdateStatus("Island or Nodes not found")
            break
        end

        UpdateStatus("Scanning...")

        local Pairs = FindPairs(Nodes)

        Stats.Pairs = #Pairs
        Stats.Rounds += 1
        UpdateStats()

        if #Pairs == 0 then
            UpdateStatus("No Snapdragon pairs found")
            break
        end

        if not Equipped then
            WaitForRoot()
            EquipPollinator()
        end

        for Index, Pair in ipairs(Pairs) do
            if not Running then break end

            UpdateStatus(("Pair %d/%d"):format(Index, #Pairs))

            if not Equipped then
                EquipPollinator()
            end

            PollinatePair(Pair)
        end

        if not (Running and CFG.Loop) then
            break
        end

        UpdateStatus("Round done, waiting...")
        task.wait(CFG.LoopDelay)
    end

    if Running then
        Running = false
        UpdateStatus("Done")
    end
end

--==================================================
-- UI
--==================================================

MainTab:CreateToggle({
    Name = "Auto Pollination",
    CurrentValue = false,
    Flag = "VANTA_AutoPollination",

    Callback = function(Value)
        if Value then
            if Running then return end

            Running = true
            Equipped = false
            Stats.Done = 0
            Stats.Rounds = 0
            UpdateStats()

            task.spawn(Run)
        else
            Running = false
            UpdateStatus("Stopped")
        end
    end,
})

MainTab:CreateToggle({
    Name = "Loop (go round again when finished)",
    CurrentValue = CFG.Loop,
    Flag = "VANTA_Loop",

    Callback = function(Value)
        CFG.Loop = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Pair distance (cells)",
    Range = { 1, 4 },
    Increment = 1,
    Suffix = " cells",
    CurrentValue = CFG.MaxCells,
    Flag = "VANTA_MaxCells",

    Callback = function(Value)
        CFG.MaxCells = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Grid Size",
    Range = { 2, 12 },
    Increment = 1,
    Suffix = " studs",
    CurrentValue = CFG.GridSize,
    Flag = "VANTA_GridSize",

    Callback = function(Value)
        CFG.GridSize = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Teleport Height",
    Range = { 2, 10 },
    Increment = 1,
    Suffix = " studs",
    CurrentValue = CFG.TeleportHeight,
    Flag = "VANTA_TeleportHeight",

    Callback = function(Value)
        CFG.TeleportHeight = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Pollination Delay",
    Range = { 0.05, 2 },
    Increment = 0.05,
    Suffix = " seconds",
    CurrentValue = CFG.PollinationDelay,
    Flag = "VANTA_PollinationDelay",

    Callback = function(Value)
        CFG.PollinationDelay = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Teleport Delay",
    Range = { 0.05, 1 },
    Increment = 0.05,
    Suffix = " seconds",
    CurrentValue = CFG.TeleportDelay,
    Flag = "VANTA_TeleportDelay",

    Callback = function(Value)
        CFG.TeleportDelay = Value
    end,
})

Player.CharacterAdded:Connect(function()
    Equipped = false -- re-equips the pollinator after a respawn
end)

Rayfield:Notify({
    Title = "VANTA",
    Content = "Auto Pollination v2.0 loaded.",
    Duration = 5,
})

UpdateStatus("Ready")
