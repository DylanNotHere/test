--==================================================
-- VANTA | COMBAT & RESOURCE HUB (Noclip)
--==================================================

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "VANTA | Farm Hub",
    loadingTitle = "VANTA",
    loadingSubtitle = "Combat & Resources",
})

local Tab = Window:CreateTab({ name = "Farm" })

local CFG = {
    GlideSpeed = 45,
    MobHoverHeight = 20,
    BossHoverHeight = 20,
    TreeHoverHeight = 6,
    OreHoverHeight = -5,
    
    ShootDelay = 0.25,
    BurstAmount = 3,
    BurstDelay = 0.1,
    
    WeaponType = "Scepter",
}

local function applyWeaponStats()
    if CFG.WeaponType == "Bow" then
        CFG.ShootRange = 50
        CFG.WeaponName = "Bow" 
    elseif CFG.WeaponType == "Sword" then
        CFG.ShootRange = 15
        CFG.WeaponName = "Sword"
    else
        CFG.ShootRange = 25
        CFG.WeaponName = "Scepter"
    end
end
applyWeaponStats()

local state = { AutoFarm = false, Mob = false, Ore = false, Tree = false, Boss = false }
local shotCounter = 1

local skeletonNames = {
    ["Skeleton"] = true, ["SkeletonArcher"] = true, 
    ["SkeletonKnight"] = true, ["SkeletonWarrior"] = true
}
local bossNames = { ["Morten"] = true }

--==================================================
-- NOCLIP
--==================================================
local noclipEnabled = false
local noclipConnection

local function toggleNoclip(on)
    noclipEnabled = on
    if on then
        if noclipConnection then return end
        noclipConnection = RunService.Stepped:Connect(function()
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end
end

--==================================================
-- UTILS & PHYSICS
--==================================================
local function getChar()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then return hum, root end
end

local function isAlive(m)
	if not m.Parent then return false end
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then return hum.Health > 0 end
	return true
end

local bodyPos, bodyGyro
local function startGlidePhysics(hum, root)
    if bodyPos then return end
    hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
    
    bodyPos = Instance.new("BodyPosition")
    bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyPos.P = 20000
    bodyPos.D = 2000
    bodyPos.Position = root.Position
    bodyPos.Parent = root
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P = 10000
    bodyGyro.D = 1000
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root
end

local function stopGlidePhysics()
    if bodyPos then bodyPos:Destroy(); bodyPos = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    local hum = getChar()
    if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true) end
end

--==================================================
-- TARGETING
--==================================================
local function getNearestMob(root)
	local ruins = workspace:FindFirstChild("Ruins")
	local ruinsBoss = workspace:FindFirstChild("RuinsBoss")
	local best, bestDist = nil, math.huge
    local isBoss = false

	-- Boss Priority
	if state.Boss and ruinsBoss then
		for _, inst in ipairs(ruinsBoss:GetDescendants()) do
			if inst:IsA("Model") and bossNames[inst.Name] and isAlive(inst) then
                return inst, true
			end
		end
	end

	if not ruins then return nil end

	if state.Mob then
		local folder = ruins:FindFirstChild("Guardians")
		if folder then
			for _, inst in ipairs(folder:GetDescendants()) do
				if inst:IsA("Model") and skeletonNames[inst.Name] and isAlive(inst) then
					local mobRoot = inst:FindFirstChild("HumanoidRootPart")
                    if mobRoot then
                        local d = (mobRoot.Position - root.Position).Magnitude
                        if d < bestDist then
                            best = inst; bestDist = d
                        end
                    end
				end
			end
		end
	end

	return best, isBoss
end

local function getNearestResource(root)
    local ruins = workspace:FindFirstChild("Ruins")
    local folder = ruins and ruins:FindFirstChild("ResourceField")
    if not folder then return nil end

    local best, bestDist = nil, math.huge
    local isTree = false

    for _, inst in ipairs(folder:GetDescendants()) do
        if inst:IsA("Model") and isAlive(inst) then
            local hb = inst:FindFirstChild("Reach") or inst.PrimaryPart
            if hb then
                local isOre = (inst.Name:find("Ore") or inst.Name == "Coal") and state.Ore
                local isTr = (inst.Name:find("Pine") or inst.Name:find("Tree")) and state.Tree
                
                if isOre or isTr then
                    local d = (hb.Position - root.Position).Magnitude
                    if d < bestDist then
                        best = hb; bestDist = d; isTree = isTr
                    end
                end
            end
        end
    end
    return best, isTree
end

local function equipTool(namePart)
    local char = player.Character
    if char then
        local currentTool = char:FindFirstChildOfClass("Tool")
        if not currentTool or not currentTool.Name:find(namePart) then
            RS.Remotes.RequestEquipSlot:FireServer(namePart)
            task.wait(0.4)
        end
    end
end

--==================================================
-- ACTIONS
--==================================================
local function shootMob(model, isBoss)
    local mobRoot = model:FindFirstChild("HumanoidRootPart")
    if not mobRoot then return end
    
    equipTool(CFG.WeaponName)
    
    local hover = isBoss and CFG.BossHoverHeight or CFG.MobHoverHeight
    local targetPos = mobRoot.Position + Vector3.new(0, hover, 0)
    bodyPos.Position = targetPos
    
    local hum, root = getChar()
    local lastShoot = 0
    
    while state.AutoFarm and isAlive(model) and (mobRoot.Position - root.Position).Magnitude <= CFG.ShootRange + 5 do
        if os.clock() - lastShoot >= CFG.ShootDelay then
            lastShoot = os.clock()
            local dir = (mobRoot.Position - root.Position).Unit
            pcall(function() 
                if CFG.WeaponType == "Sword" then
                    RS.Remotes.RequestSwing:FireServer(mobRoot)
                else
                    RS.Remotes.RequestShoot:FireServer(mobRoot.Position, dir, 1, shotCounter) 
                end
            end)
            shotCounter += 1
        end
        RunService.Heartbeat:Wait()
    end
end

local function mineResource(hb, isTree)
    equipTool(isTree and "Axe" or "Pickaxe")
    local hover = isTree and CFG.TreeHoverHeight or CFG.OreHoverHeight
    local targetPos = hb.Position + Vector3.new(0, hover, 0)
    bodyPos.Position = targetPos
    
    local hum, root = getChar()
    while state.AutoFarm and hb.Parent and (root.Position - hb.Position).Magnitude <= 15 do
        for i = 1, CFG.BurstAmount do
            if not hb.Parent then break end
            pcall(function() RS.Remotes.RequestSwing:FireServer(hb) end)
            task.wait(CFG.BurstDelay)
        end
        task.wait(0.2)
    end
end

--==================================================
-- MAIN LOOP
--==================================================
local function farmLoop()
    while state.AutoFarm do
        local hum, root = getChar()
        if not hum then 
            task.wait(1) 
        else
            startGlidePhysics(hum, root)
            
            local targetMob, isBoss = getNearestMob(root)
            
            if targetMob then
                shootMob(targetMob, isBoss)
            else
                local targetRes, isTree = getNearestResource(root)
                if targetRes then
                    mineResource(targetRes, isTree)
                else
                    task.wait(0.5)
                end
            end
        end
    end
    stopGlidePhysics()
end

--==================================================
-- UI
--==================================================
Tab:CreateToggle({
    name = "Noclip",
    flag = "Noclip",
    currentValue = false,
    callback = function(on)
        toggleNoclip(on)
    end,
})

Tab:CreateToggle({
    name = "Auto Farm",
    flag = "AutoFarm",
    currentValue = false,
    callback = function(on)
        state.AutoFarm = on
        if on then task.spawn(farmLoop) else stopGlidePhysics() end
    end,
})

Tab:CreateDropdown({
    name = "Weapon Type (Mobs)",
    options = {"Scepter", "Bow", "Sword"},
    currentOption = {"Scepter"},
    multipleOptions = false,
    callback = function(option)
        CFG.WeaponType = option[1]
        applyWeaponStats()
    end,
})

Tab:CreateToggle({ name = "Farm Mobs", flag = "T_Mob", currentValue = true, callback = function(on) state.Mob = on end })
Tab:CreateToggle({ name = "Farm Boss (Morten)", flag = "T_Boss", currentValue = false, callback = function(on) state.Boss = on end })
Tab:CreateToggle({ name = "Farm Ores", flag = "T_Ore", currentValue = true, callback = function(on) state.Ore = on end })
Tab:CreateToggle({ name = "Farm Trees", flag = "T_Tree", currentValue = true, callback = function(on) state.Tree = on end })
