-- slimefarmer_v4.1.0 (Mega Hub: Tween Movement + GoldOre)
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local window = Rayfield:CreateWindow({
	name = "Mega Hub",
	loadingTitle = "VANTA",
	loadingSubtitle = "by dj",
})

local main = window:CreateTab({ name = "Combat" })
local resourceTab = window:CreateTab({ name = "Resources" })
local settingsTab = window:CreateTab({ name = "Settings" })

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Remotes = RS:WaitForChild("Remotes")

local CFG = {
	GlideSpeed = 45,
	GlideTimeout = 10,
	StopDistance = 6,
	AttackRange = 15,
	SwingsPerTick = 3,
	SwingDelay = 0.15,
	BlockedRadius = 5,
}

local blockedSpots = {
	Vector3.new(8, 196, -80),
	Vector3.new(24, 192, -112),
	Vector3.new(9, -198.5, 0),
}

local state = { 
    WalkToTarget = false, 
    AutoAttack = false,
    AutoMobs = false,
    AutoOres = false,
    AutoTrees = false
}

-- ===== Target Cache =====
local validMobs = { ["Slime"] = true, ["Skeleton"] = true, ["SkeletonArcher"] = true }
local validOres = { ["Coal"] = true, ["IronOre"] = true, ["GoldOre"] = true }
local validTrees = { ["Pine"] = true }

local targets = {} -- [Model] = true

local function track(inst)
    if inst:IsA("Model") then
        if (validMobs[inst.Name] and state.AutoMobs) or 
           (validOres[inst.Name] and state.AutoOres) or 
           (validTrees[inst.Name] and state.AutoTrees) then
            targets[inst] = true
        end
    end
end

for _, v in ipairs(workspace:GetDescendants()) do track(v) end
workspace.DescendantAdded:Connect(track)
workspace.DescendantRemoving:Connect(function(inst) targets[inst] = nil end)

local function isBlocked(pos)
	for _, blocked in ipairs(blockedSpots) do
		if (pos - blocked).Magnitude < CFG.BlockedRadius then return true end
	end
	return false
end

local function nearestTarget(fromPos)
	local best, bestDist = nil, math.huge
	for target in pairs(targets) do
		if target.Parent then
            local isAlive = true
            local hum = target:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then isAlive = false end
            
            if isAlive then
                local pos = target:GetPivot().Position
                local d = (pos - fromPos).Magnitude
                if d < bestDist and not isBlocked(pos) then
                    best, bestDist = target, d
                end
            end
		end
	end
	return best, bestDist
end

local function getChar()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then return end
	return char, hum, root
end

-- ===== Equip =====
local function equip(toolName)
	pcall(function()
		Remotes.RequestEquipSlot:FireServer(toolName)
	end)
end

-- ===== Glide / Tween Movement =====
local function glideTo(target)
	local char, hum, root = getChar()
	if not hum then return false end

	local start = os.clock()
	hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false) -- No falling pose

	while state.WalkToTarget and target.Parent and hum.Health > 0 do
		local targetPos = target:GetPivot().Position
		if (targetPos - root.Position).Magnitude <= CFG.StopDistance then
			hum:Move(Vector3.zero, false)
			return true
		end
		if os.clock() - start > CFG.GlideTimeout then
			break
		end

		local dt = RunService.Heartbeat:Wait()
		local offset = targetPos - root.Position
        
		if offset.Magnitude > 0.5 then
			local step = math.min(CFG.GlideSpeed * dt, offset.Magnitude)
			root.CFrame = root.CFrame + offset.Unit * step
		end
		root.AssemblyLinearVelocity = Vector3.zero -- Hover in place

		-- Play walking animation so it looks somewhat legit
		local flat = Vector3.new(offset.X, 0, offset.Z)
		hum:Move(flat.Magnitude > 1 and flat.Unit or Vector3.zero, false)
		if hum:GetState() == Enum.HumanoidStateType.Freefall then
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end
	end

	hum:Move(Vector3.zero, false)
	return target.Parent ~= nil and (target:GetPivot().Position - root.Position).Magnitude <= CFG.AttackRange
end

-- ===== Attack / Harvest =====
local function getHitbox(target)
    return target:FindFirstChild("Reach") or target.PrimaryPart or target
end

local function attackStep()
    local char, hum, root = getChar()
    if not root then return end
    
    local target, dist = nearestTarget(root.Position)
    if not target or dist > CFG.AttackRange then return end
    
    -- Auto Tool Swap
    if validTrees[target.Name] then
        if not char:FindFirstChild("Iron Axe") and not char:FindFirstChild("Axe") then equip("Axe") end
    elseif validOres[target.Name] then
        if not char:FindFirstChild("Iron Pickaxe") and not char:FindFirstChild("Pickaxe") then equip("Pickaxe") end
    elseif validMobs[target.Name] then
        if not char:FindFirstChild("Iron Sword") and not char:FindFirstChild("Sword") then equip("Weapon") end
    end

    local hitbox = getHitbox(target)
    
    pcall(function()
        for _ = 1, CFG.SwingsPerTick do
            Remotes.RequestSwing:FireServer(hitbox)
        end
    end)
end

-- ===== UI Setup =====
main:CreateToggle({
	name = "Walk / Glide to Target",
	flag = "WalkToTarget",
	currentValue = false,
	callback = function(on)
		state.WalkToTarget = on
		if on then
			task.spawn(function()
				while state.WalkToTarget do
					local _, _, root = getChar()
                    if root then
                        local target = nearestTarget(root.Position)
                        if target then
                            glideTo(target)
                        end
                    end
					task.wait(0.1)
				end
			end)
		end
	end,
})

main:CreateToggle({
	name = "Auto Attack (Mobs)",
	flag = "AutoMobs",
	currentValue = false,
	callback = function(on) state.AutoMobs = on end,
})

resourceTab:CreateToggle({
	name = "Auto Mine (Ores)",
	flag = "AutoOres",
	currentValue = false,
	callback = function(on) state.AutoOres = on end,
})

resourceTab:CreateToggle({
	name = "Auto Chop (Trees)",
	flag = "AutoTrees",
	currentValue = false,
	callback = function(on) state.AutoTrees = on end,
})

main:CreateToggle({
	name = "Enable Attacker",
	flag = "AutoAttack",
	currentValue = false,
	callback = function(on)
		state.AutoAttack = on
		if on then
			task.spawn(function()
				while state.AutoAttack do
					pcall(attackStep)
					task.wait(CFG.SwingDelay)
				end
			end)
		end
	end,
})

settingsTab:CreateSlider({
	name = "Glide Speed",
    range = { 10, 150 },
    increment = 5,
    suffix = " studs/s",
    currentValue = CFG.GlideSpeed,
	callback = function(val)
		CFG.GlideSpeed = val
	end,
})
