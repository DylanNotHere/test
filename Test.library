--==================================================
-- VANTA | AUTOFARM v2.4.0
-- Mobs & Ores below, Boss above
--==================================================

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/gen2"
))()

local Window = Rayfield:CreateWindow({
    name = "VANTA | Ruins Farm",
    loadingTitle = "VANTA",
    loadingSubtitle = "Auto Farm",
})

local Tab = Window:CreateTab({ name = "Farm" })

--==================================================
-- CONFIG
--==================================================

local CFG = {
    GlideSpeed = 40,
    HoverHeight = 12,        -- Default (unused)
    BossHoverHeight = 15,    -- Morten height
    MobHoverHeight = -5,     -- Skeleton height (below)
    NodeHoverHeight = -5,    -- Ores/Trees height (below)
    SwingRange = 16,

    MobSwing = 0.36,
    NodeSwing = 0.22,

    MobTimeout = 25,
    NodeTimeout = 10,
}

local state = {
    AutoFarm = false,
    Mob = false,
    Ore = false,
    Tree = false,
    Boss = false,
}

--==================================================
-- TARGET NAMES
--==================================================

local skeletonNames = {
    ["Skeleton"] = true,
    ["SkeletonArcher"] = true,
    ["SkeletonKnight"] = true,
    ["SkeletonWarrior"] = true,
}

local bossNames = {
    ["Morten"] = true,
}

--==================================================
-- CHARACTER
--==================================================

local function getChar()
    local char = player.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if hum and root and hum.Health > 0 then
        return hum, root
    end
end

--==================================================
-- HITBOX TARGETING
--==================================================

local function getHitbox(m, isMob)
    if isMob then
        return m:FindFirstChild("HumanoidRootPart")
    else
        return m:FindFirstChild("Reach")
            or m.PrimaryPart
            or m
    end
end

local function targetPos(m, isMob)
    if isMob then
        local root = m:FindFirstChild("HumanoidRootPart")

        if root and root:IsA("BasePart") then
            return root.Position
        end

        return m:GetPivot().Position
    end

    local hb = getHitbox(m, false)

    if hb and hb:IsA("BasePart") then
        return hb.Position
    end

    return m:GetPivot().Position
end

--==================================================
-- ALIVE CHECK
--==================================================

local function isAlive(m, isMob)
    if not m.Parent then
        return false
    end

    if isMob then
        local hum = m:FindFirstChildOfClass("Humanoid")

        if hum then
            return hum.Health > 0
        end

        local hp = m:GetAttribute("Health")

        if type(hp) == "number" then
            return hp > 0
        end
    end

    return true
end

--==================================================
-- FIND NEAREST TARGET
--==================================================

local function getNearestTarget(root)
    local ruins = workspace:FindFirstChild("Ruins")
    local ruinsBoss = workspace:FindFirstChild("RuinsBoss")

    local best = nil
    local bestDist = math.huge
    local bestIsMob = false

    -- 1. BOSS (MORTEN PRIORITY)
    if state.Boss and ruinsBoss then
        for _, inst in ipairs(ruinsBoss:GetDescendants()) do
            if inst:IsA("Model") and bossNames[inst.Name] then
                if isAlive(inst, true) then
                    local mobRoot = inst:FindFirstChild("HumanoidRootPart")
                    if mobRoot and mobRoot:IsA("BasePart") then
                        return inst, true
                    end
                end
            end
        end
    end

    if not ruins then return nil end

    -- 2. SKELETONS
    if state.Mob then
        local folder = ruins:FindFirstChild("Guardians")

        if folder then
            for _, inst in ipairs(folder:GetDescendants()) do
                if inst:IsA("Model") and skeletonNames[inst.Name] then
                    if isAlive(inst, true) then
                        local mobRoot = inst:FindFirstChild("HumanoidRootPart")
                        if mobRoot and mobRoot:IsA("BasePart") then
                            local d = (mobRoot.Position - root.Position).Magnitude
                            if d < bestDist then
                                best = inst
                                bestDist = d
                                bestIsMob = true
                            end
                        end
                    end
                end
            end
        end
    end

    -- 3. ORES / TREES
    if state.Ore or state.Tree then
        local folder = ruins:FindFirstChild("ResourceField")

        if folder then
            for _, inst in ipairs(folder:GetDescendants()) do
                if inst:IsA("Model") and inst.Parent == folder then
                    local isOre = inst.Name:find("Ore") or inst.Name == "Coal"
                    local isTree = inst.Name:find("Pine") or inst.Name:find("Tree")

                    local valid = (state.Ore and isOre) or (state.Tree and isTree)

                    if valid and isAlive(inst, false) then
                        local d = (targetPos(inst, false) - root.Position).Magnitude
                        if d < bestDist then
                            best = inst
                            bestDist = d
                            bestIsMob = false
                        end
                    end
                end
            end
        end
    end

    return best, bestIsMob
end

--==================================================
-- EQUIP TOOL
--==================================================

local function equipFor(isMob, name)
    local tool = "Weapon"

    if not isMob then
        if name:find("Ore") or name == "Coal" then
            tool = "Pickaxe"
        else
            tool = "Axe"
        end
    end

    local char = player.Character

    if char then
        local currentTool = char:FindFirstChildOfClass("Tool")

        if not currentTool or currentTool.Name ~= tool then
            RS.Remotes.RequestEquipSlot:FireServer(tool)
            task.wait(0.4)
        end
    end
end

--==================================================
-- HOVER / GLIDE
--==================================================

local hoverCF
local hoverConn

local function startHover(hum, root)
    if hoverConn then return end

    hoverCF = root.CFrame
    hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)

    hoverConn = RunService.Heartbeat:Connect(function()
        if root.Parent then
            root.CFrame = hoverCF
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

local function stopHover()
    if hoverConn then
        hoverConn:Disconnect()
        hoverConn = nil
    end

    hoverCF = nil

    local hum = getChar()

    if hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        hum:Move(Vector3.zero, false)
    end
end

--==================================================
-- ENGAGE TARGET
--==================================================

local function engage(model, isMob)
    local Swing = RS.Remotes.RequestSwing

    local swingDelay = isMob and CFG.MobSwing or CFG.NodeSwing
    local deadline = os.clock() + (isMob and CFG.MobTimeout or CFG.NodeTimeout)
    local lastSwing = 0

    while state.AutoFarm and os.clock() < deadline do
        if not model.Parent then return true end
        if not isAlive(model, isMob) then return true end

        local hum, root = getChar()

        if not hum then 
            stopHover()
            return false 
        end

        startHover(hum, root)

        local goal
        if isMob and not bossNames[model.Name] then
            -- Mob: Tween below
            goal = targetPos(model, isMob) + Vector3.new(0, CFG.MobHoverHeight, 0)
        elseif not isMob then
            -- Ore/Tree: Tween below
            goal = targetPos(model, isMob) + Vector3.new(0, CFG.NodeHoverHeight, 0)
        else
            -- Boss: Tween above
            goal = targetPos(model, isMob) + Vector3.new(0, CFG.BossHoverHeight, 0)
        end

        local d = goal - hoverCF.Position
        local dt = RunService.Heartbeat:Wait()

        if d.Magnitude > 1.5 then
            hoverCF = hoverCF + d.Unit * math.min(CFG.GlideSpeed * dt, d.Magnitude)
            local flat = Vector3.new(d.X, 0, d.Z)
            hum:Move(flat.Magnitude > 1 and flat.Unit or Vector3.zero, false)
        else
            hum:Move(Vector3.zero, false)
        end

        if d.Magnitude <= CFG.SwingRange and os.clock() - lastSwing >= swingDelay then
            local hitbox = getHitbox(model, isMob)
            if hitbox then
                lastSwing = os.clock()
                Swing:FireServer(hitbox)
            end
        end
    end

    return not isAlive(model, isMob)
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()
    while state.AutoFarm do
        local hum, root = getChar()

        if not hum then
            stopHover()
            task.wait(1)
        else
            local target, isMob = getNearestTarget(root)

            if target then
                equipFor(isMob, target.Name)
                engage(target, isMob)
            else
                task.wait(0.5)
            end
        end
    end

    stopHover()
end

--==================================================
-- RAYFIELD CONTROLS
--==================================================

Tab:CreateToggle({
    name = "Auto Farm",
    flag = "AutoFarm",
    currentValue = false,
    callback = function(on)
        state.AutoFarm = on
        if on then
            task.spawn(farmLoop)
        else
            stopHover()
        end
    end
})

Tab:CreateToggle({
    name = "Include Boss (Morten)",
    flag = "FarmBoss",
    currentValue = false,
    callback = function(on)
        state.Boss = on
    end
})

Tab:CreateToggle({
    name = "Include Mobs",
    flag = "FarmMobs",
    currentValue = true,
    callback = function(on)
        state.Mob = on
    end
})

Tab:CreateToggle({
    name = "Include Ores",
    flag = "FarmOres",
    currentValue = true,
    callback = function(on)
        state.Ore = on
    end
})

Tab:CreateToggle({
    name = "Include Trees",
    flag = "FarmTrees",
    currentValue = true,
    callback = function(on)
        state.Tree = on
    end
})
