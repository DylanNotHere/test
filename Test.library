-- ==================================================
-- VANTA | BERRY PLANTER (Hardcoded Snake)
-- ==================================================
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local function dual(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
		out[k:sub(1, 1):upper() .. k:sub(2)] = v
	end
	return out
end

local Window = Rayfield:CreateWindow(dual({
	name = "VANTA | Berry Planter",
	loadingTitle = "VANTA",
	loadingSubtitle = "Snake Pattern",
}))
local Tab = Window:CreateTab(dual({ name = "Planter" }))

local CFG = {
	Spacing = 1,
	PlantDelay = 0.15,
	MaxDelay = 1.5,
	ConfirmTimeout = 2,
	MaxMisses = 4,
	GlideSpeed = 30,
	HoverHeight = 4,
}

local KEY_PATTERN = "^(-?%d+),(-?%d+),(-?%d+)$"
local function fmt(x, y, z) return string.format("%d,%d,%d", x, y, z) end
local function notify(title, content) pcall(function() Window:Notify(dual({ title = title, content = content, duration = 5 })) end) end

-- ===== state =====
local Enabled = false
local RunId = 0
local BlocksFolder, occupied, blockKey, conns = nil, {}, {}, {}

local function findIsland()
	local fallback
	for _, c in ipairs(workspace:GetChildren()) do
		if c.Name:match("^Island_") and c:FindFirstChild("Blocks") then
			if c.Name:find(tostring(player.UserId), 1, true) then return c end
			fallback = fallback or c
		end
	end
	return fallback
end

local function register(block)
	local key = block:GetAttribute("CellKey")
	if key then occupied[key] = block; blockKey[block] = key; return end
	local conn = block:GetAttributeChangedSignal("CellKey"):Connect(function()
		local k = block:GetAttribute("CellKey")
		if k then occupied[k] = block; blockKey[block] = k; conn:Disconnect() end
	end)
	task.delay(3, function() if conn.Connected then conn:Disconnect() end end)
end

local function unregister(block)
	local key = blockKey[block]
	if key then if occupied[key] == block then occupied[key] = nil end; blockKey[block] = nil end
end

local function blockPos(b) return b:IsA("BasePart") and b.Position or b:GetPivot().Position end
local function parseKey(key) local x, y, z = key:match(KEY_PATTERN) return tonumber(x), tonumber(y), tonumber(z) end

-- ===== glide engine =====
local function getChar()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then return hum, root end
end

local hoverCF, hoverConn
local function startHover(hum, root)
	if hoverConn then return end
	hoverCF = root.CFrame
	hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
	hoverConn = RunService.Heartbeat:Connect(function()
		if root.Parent then
			root.CFrame = hoverCF
			root.AssemblyLinearVelocity = Vector3.zero
			if hum:GetState() == Enum.HumanoidStateType.Freefall then hum:ChangeState(Enum.HumanoidStateType.Running) end
		end
	end)
end

local function stopHover()
	if hoverConn then hoverConn:Disconnect(); hoverConn = nil end
	hoverCF = nil
	local hum = getChar()
	if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true); hum:Move(Vector3.zero, false) end
end

local function glideAbove(pos, offset, run)
	local hum, root = getChar()
	if not hum then return false end
	startHover(hum, root)
	local goal = pos + Vector3.new(0, offset, 0)
	while Enabled and run == RunId do
		if hum.Health <= 0 then return false end
		local d = goal - hoverCF.Position
		if d.Magnitude <= 0.75 then break end
		local dt = RunService.Heartbeat:Wait()
		hoverCF = hoverCF + d.Unit * math.min(CFG.GlideSpeed * dt, d.Magnitude)
		local flat = Vector3.new(d.X, 0, d.Z)
		hum:Move(flat.Magnitude > 1 and flat.Unit or Vector3.zero, false)
	end
	hum:Move(Vector3.zero, false)
	return true
end

-- ===== planting =====
local planting = false

local function buildTargets()
	-- Find the highest Y level of grass
	local maxY = -math.huge
	for key, b in pairs(occupied) do
		if b:GetAttribute("BlockId") == "GrassBlock" then
			local _, y = parseKey(key)
			if y > maxY then maxY = y end
		end
	end
	if maxY == -math.huge then return {} end

	local rows = {}
	for key, b in pairs(occupied) do
		if b:GetAttribute("BlockId") == "GrassBlock" then
			local x, y, z = parseKey(key)
			if y == maxY then
				rows[z] = rows[z] or {}
				table.insert(rows[z], { x = x, z = z, block = b, key = fmt(x, y + 1, z) })
			end
		end
	end

	local z_keys = {}
	for z in pairs(rows) do table.insert(z_keys, z) end
	table.sort(z_keys)

	local targets = {}
	local Spacing = math.max(1, math.floor(CFG.Spacing))
	
	for n, z in ipairs(z_keys) do
		local row = rows[z]
		table.sort(row, function(a, b)
			if n % 2 == 1 then return a.x < b.x else return a.x > b.x end
		end)
		
		for _, t in ipairs(row) do
			-- Apply spacing
			if (t.x % Spacing == 0) and (t.z % Spacing == 0) then
				-- Only plant if there's nothing there
				if not occupied[t.key] then
					table.insert(targets, t)
				end
			end
		end
	end
	return targets
end

local function plantAll(run)
	planting = true
	local Remote = RS:WaitForChild("Remotes"):WaitForChild("RequestPlace")
	local targets = buildTargets()
	
	print(("[Planter] %d spots to plant"):format(#targets))
	notify("Planting", ("%d spots"):format(#targets))

	local delay = CFG.PlantDelay
	local planted, misses = 0, 0

	for _, t in ipairs(targets) do
		if not Enabled or run ~= RunId then break end
		
		if t.block.Parent then
			glideAbove(blockPos(t.block), CFG.HoverHeight, run)

			-- HARDCODED FROM COBALT DUMP
			local targetPos = { x = t.x, y = t.block.Position.Y / 4 + 1, z = t.z }
			-- (Using the block's grid Y + 1 for the seed height)
			local _, by, _ = parseKey(t.block:GetAttribute("CellKey"))
			
			Remote:FireServer({ x = t.x, y = by + 1, z = t.z }, "BerryBushSeed", 0, Vector3.new(0,1,0), false, nil, false, 5)

			-- Wait for the bush to appear (block above becomes occupied)
			local deadline = os.clock() + CFG.ConfirmTimeout
			local ok = false
			while os.clock() < deadline and Enabled and run == RunId do
				if occupied[t.key] then ok = true break end
				task.wait(0.03)
			end

			if ok then
				planted += 1
				misses = 0
				delay = math.max(CFG.PlantDelay, delay * 0.95)
			else
				misses += 1
				delay = math.min(delay * 1.6 + 0.05, CFG.MaxDelay)
				if misses >= CFG.MaxMisses then
					notify("Stopped", "Plants aren't confirming. Server might be rejecting placements.")
					break
				end
			end
			task.wait(delay)
		end
	end

	print(("[Planter] done: %d planted"):format(planted))
	stopHover()
	planting = false
end

local function disconnectAll()
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
end

local function arm()
	local island = findIsland()
	BlocksFolder = island and island:FindFirstChild("Blocks")
	if not BlocksFolder then warn("Couldn't find Blocks folder"); return false end

	occupied, blockKey = {}, {}
	for _, b in ipairs(BlocksFolder:GetChildren()) do register(b) end

	table.insert(conns, BlocksFolder.ChildAdded:Connect(register))
	table.insert(conns, BlocksFolder.ChildRemoved:Connect(unregister))
	return true
end

-- ===== UI =====
Tab:CreateToggle(dual({
	name = "Auto Plant",
	flag = "AutoPlant",
	currentValue = false,
	callback = function(on)
		Enabled = on
		RunId += 1
		disconnectAll()

		if not on then
			notify("Auto Plant off", "Stopped.")
			return
		end

		if not arm() then return end
		notify("Auto Plant on", "Planting snake pattern...")
		task.spawn(plantAll, RunId)
	end,
}))

Tab:CreateSlider(dual({
	name = "Spacing (1 = every block)",
	flag = "PlantSpacing",
	range = { 1, 5 },
	increment = 1,
	suffix = " blocks",
	currentValue = CFG.Spacing,
	callback = function(v) CFG.Spacing = math.floor(v) end,
}))

Tab:CreateSlider(dual({
	name = "Plant Delay",
	flag = "PlantDelay",
	range = { 0.03, 1 },
	increment = 0.01,
	suffix = " s",
	currentValue = CFG.PlantDelay,
	callback = function(v) CFG.PlantDelay = v end,
}))

Window:Notify(dual({ title = "VANTA Planter", content = "Loaded. Toggle to start.", duration = 5 }))
