--==================================================
-- VANTA | MEGA FARM (Soul Scepter + Priority)
-- Priorities: Boss > Gold Ore > Other Targets
--==================================================

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "VANTA | Mega Farm",
    loadingTitle = "VANTA",
    loadingSubtitle = "by dj",
})

local Tab = Window:CreateTab({ name = "Farm" })

local CFG = {
    GlideSpeed = 40,
    
    -- Hover Heights
    BossHoverHeight = 15,
    MobHoverHeight = 15,
    NodeHoverHeight = -5, -- Below the ore
    TreeHoverHeight = 6,  -- Above the tree

    ShootRange = 25,
    ShootDelay = 0.3,
    MeleeRange = 14,
    MeleeDelay = 0.22,
}

local state = {
    AutoFarm = false,
    Mob = false,
    Ore = false,
    Tree = false,
    Boss = false,
}

local shotCounter = 1

local skeletonNames = { ["Skeleton"] = true, ["SkeletonArcher"] = true, ["SkeletonKnight"] = true, ["SkeletonWarrior"] = true }
local bossNames = { ["Morten"] = true }

local function getChar()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then return hum, root end
end

local function isAlive(m, isMob)
	if not m.Parent then return false end
	if isMob then
		local hum = m:FindFirstChildOfClass("Humanoid")
		if hum then return hum.Health > 0 end
		local hp = m:GetAttribute("Health")
		if type(hp) == "number" then return hp > 0 end
	end
	return true
end

--==================================================
-- TARGETING & PRIORITY
--==================================================

local function getNearestTarget(root)
	local ruins = workspace:FindFirstChild("Ruins")
	local ruinsBoss = workspace:FindFirstChild("RuinsBoss")
    
	local best, bestDist, bestIsMob = nil, math.huge, false

	-- 1. BOSS (Highest Priority)
	if state.Boss and ruinsBoss then
		for _, inst in ipairs(ruinsBoss:GetDescendants()) do
			if inst:IsA("Model") and bossNames[inst.Name] and isAlive(inst, true) then
                return inst, true
			end
		end
	end

	if not ruins then return nil end

    -- 2. GOLD ORE PRIORITY (Inside ResourceField)
    if state.Ore then
        local folder = ruins:FindFirstChild("ResourceField")
        if folder then
            for _, inst in ipairs(folder:GetDescendants()) do
                if inst:IsA("Model") and inst.Name == "GoldOre" and isAlive(inst, false) then
                    return inst, false
                end
            end
        end
    end

	-- 3. MOBS
	if state.Mob then
		local folder = ruins:FindFirstChild("Guardians")
		if folder then
			for _, inst in ipairs(folder:GetDescendants()) do
				if inst:IsA("Model") and skeletonNames[inst.Name] and isAlive(inst, true) then
					local mobRoot = inst:FindFirstChild("HumanoidRootPart")
                    if mobRoot then
                        local d = (mobRoot.Position - root.Position).Magnitude
                        if d < bestDist then best = inst; bestDist = d; bestIsMob = true end
                    end
				end
			end
		end
	end

	-- 4. OTHER ORES / TREES
	if state.Ore or state.Tree then
		local folder = ruins:FindFirstChild("ResourceField")
		if folder then
			for _, inst in ipairs(folder:GetDescendants()) do
				if inst:IsA("Model") and inst.Parent == folder and isAlive(inst, false) then
					local isOre = (inst.Name:find("Ore") or inst.Name == "Coal") and inst.Name ~= "GoldOre"
					local isTree = inst.Name:find("Pine") or inst.Name:find("Tree")
					local valid = (state.Ore and isOre) or (state.Tree and isTree)
					
					if valid then
                        local reach = inst:FindFirstChild("Reach") or inst.PrimaryPart
                        local pos = reach and reach.Position or inst:GetPivot().Position
						local d = (pos - root.Position).Magnitude
						if d < bestDist then best = inst; bestDist = d; bestIsMob = false end
					end
				end
			end
		end
	end

	return best, bestIsMob
end

--==================================================
-- EQUIP TOOL
--==================================================

local function equipFor(isMob, name)
	local tool = "SoulScepter"
    if not isMob then
        if name == "GoldOre" or name:find("Ore") or name == "Coal" then
            tool = "Pickaxe"
        else
            tool = "Axe"
        end
    end
	
	local char = player.Character
	if char then
        local currentTool = char:FindFirstChildOfClass("Tool")
        if not currentTool or not currentTool.Name:find(tool) then
		    RS.Remotes.RequestEquipSlot:FireServer(tool)
		    task.wait(0.4)
        end
	end
end

--==================================================
-- GLIDE & HOVER
--==================================================

local hoverCF, hoverConn
local function startHover(hum, root)
    if hoverConn then return end
    hoverCF = root.CFrame
    hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
    hoverConn = RunService.Heartbeat:Connect(function()
        if root.Parent then
            root.CFrame = hoverCF
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

local function stopHover()
    if hoverConn then hoverConn:Disconnect(); hoverConn = nil end
    hoverCF = nil
    local hum = getChar()
    if hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        hum:Move(Vector3.zero, false)
    end
end

--==================================================
-- ENGAGE TARGET
--==================================================

local function engage(model, isMob)
    local ShootRemote = RS.Remotes.RequestShoot
    local deadline = os.clock() + 25
    local lastAttack = 0

    -- Target Info
    local targetRoot = isMob and model:FindFirstChild("HumanoidRootPart") or (model:FindFirstChild("Reach") or model.PrimaryPart)
    if not targetRoot then return true end

    while state.AutoFarm and os.clock() < deadline do
        if not isAlive(model, isMob) then return true end

        local hum, root = getChar()
        if not hum then stopHover(); return false end

        startHover(hum, root)
        equipFor(isMob, model.Name)

        -- Calculate Goal (Height & Offset)
        local goal
        if isMob then
            goal = targetRoot.Position + Vector3.new(0, CFG.MobHoverHeight, 0)
        else
            local isTree = model.Name:find("Pine") or model.Name:find("Tree")
            local height = isTree and CFG.TreeHoverHeight or CFG.NodeHoverHeight
            goal = targetRoot.Position + Vector3.new(0, height, 0)
        end

        local d = goal - hoverCF.Position
        local dt = RunService.Heartbeat:Wait()

        -- Glide Logic
        if d.Magnitude > 1.5 then
            hoverCF = hoverCF + d.Unit * math.min(CFG.GlideSpeed * dt, d.Magnitude)
            local flat = Vector3.new(d.X, 0, d.Z)
            hum:Move(flat.Magnitude > 1 and flat.Unit or Vector3.zero, false)
        else
            hum:Move(Vector3.zero, false)
        end

        -- Attack Logic
        local distanceToTarget = (targetRoot.Position - root.Position).Magnitude
        
        if isMob then
            -- Shoot Mob
            if distanceToTarget <= CFG.ShootRange and os.clock() - lastAttack >= CFG.ShootDelay then
                lastAttack = os.clock()
                local direction = (targetRoot.Position - root.Position).Unit
                pcall(function()
                    ShootRemote:FireServer(targetRoot.Position, direction, 1, shotCounter)
                end)
                shotCounter += 1
            end
        else
            -- Melee Ore/Tree
            if distanceToTarget <= CFG.MeleeRange and os.clock() - lastAttack >= CFG.MeleeDelay then
                lastAttack = os.clock()
                pcall(function()
                    RS.Remotes.RequestSwing:FireServer(targetRoot)
                end)
            end
        end
    end
    return not isAlive(model, isMob)
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()
    while state.AutoFarm do
        local hum, root = getChar()
        if not hum then
            stopHover()
            task.wait(1)
        else
            local target, isMob = getNearestTarget(root)
            if target then
                engage(target, isMob)
            else
                task.wait(0.5)
            end
        end
    end
    stopHover()
end

--==================================================
-- UI
--==================================================

Tab:CreateToggle({
    name = "Auto Farm (Mega)",
    flag = "AutoFarm",
    currentValue = false,
    callback = function(on)
        state.AutoFarm = on
        if on then task.spawn(farmLoop) else stopHover() end
    end,
})

Tab:CreateToggle({ name = "Include Boss (Morten)", flag = "T_Boss", currentValue = false, callback = function(on) state.Boss = on end })
Tab:CreateToggle({ name = "Include Mobs (Skeletons)", flag = "T_Mob", currentValue = true, callback = function(on) state.Mob = on end })
Tab:CreateToggle({ name = "Include Ores (Prioritizes Gold)", flag = "T_Ore", currentValue = true, callback = function(on) state.Ore = on end })
Tab:CreateToggle({ name = "Include Trees (Pine)", flag = "T_Tree", currentValue = true, callback = function(on) state.Tree = on end })
