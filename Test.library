	range = { 1, 15 },
	increment = 1,
	suffix = "",
	currentValue = BCFG.BurstSize,
	callback = function(value)
		BCFG.BurstSize = value
	end,
})

addSlider(settingsTab, {
	name = "Field of View",
	flag = "FOV",
	range = { 40, 120 },
	increment = 1,
	suffix = "°",
	currentValue = workspace.CurrentCamera and math.floor(workspace.CurrentCamera.FieldOfView) or 70,
	callback = function(value)
