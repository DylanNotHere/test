
--==================================================
-- VANTA | AUTO POLLINATION v2.1
--
-- ORIGINAL v2.0 PAIRING + TELEPORT PRESERVED
--
-- NEW:
-- 1. Records existing Snapdragon Flowers.
-- 2. Pollinates all discovered pairs.
-- 3. Detects newly spawned Snapdragon Flowers.
-- 4. Teleports to and harvests the offspring.
-- 5. Returns to the last parent pair and pollinates again.
--
-- HARVEST:
-- RequestHarvest:FireServer(Offspring.HB)
--==================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local HoldRemote = Remotes:WaitForChild("RequestHoldBlock")
local PollinateRemote = Remotes:WaitForChild("RequestPollinate")
local HarvestRemote = Remotes:WaitForChild("RequestHarvest")

--==================================================
-- CONFIGURATION
--==================================================

local CFG = {
    FlowerName = "snapdragonflower",

    GridSize = 4,
    MaxCells = 2,
    HeightTolerance = 2,

    TeleportHeight = 3,
    TeleportDelay = 0.12,
    PollinationDelay = 0.2,

    OffspringScanDelay = 1,
    OffspringTimeout = 300,
    HarvestDelay = 0.4,

    Loop = true,
}

--==================================================
-- STATE
--==================================================

local Running = false
local Equipped = false

local Stats = {
    Pairs = 0,
    Done = 0,
    Harvested = 0,
    Rounds = 0,
}

local SeenFlowers = {}
local LastPair = nil

--==================================================
-- RAYFIELD
--==================================================

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "VANTA | Auto Pollination",
    LoadingTitle = "VANTA",
    LoadingSubtitle = "Snapdragons",
    Theme = "Default",
    DisableRayfieldPrompts = true,
})

local MainTab = Window:CreateTab("Main")
local SettingsTab = Window:CreateTab("Settings")

MainTab:CreateSection("Automation")

local StatusLabel = MainTab:CreateLabel("Status: Idle")
local StatsLabel = MainTab:CreateLabel(
    "Pairs: 0 | Pollinated: 0 | Harvested: 0"
)

local function UpdateStatus(Message)
    StatusLabel:Set("Status: " .. Message)
end

local function UpdateStats()
    StatsLabel:Set(
        ("Pairs: %d | Pollinated: %d | Harvested: %d"):format(
            Stats.Pairs,
            Stats.Done,
            Stats.Harvested
        )
    )
end

--==================================================
-- CHARACTER + TELEPORT
--==================================================

local function GetRoot()
    local Character = Player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if Humanoid and Root and Humanoid.Health > 0 then
        return Root
    end

    return nil
end

local function WaitForRoot()
    local Root = GetRoot()

    while Running and not Root do
        UpdateStatus("Waiting for respawn...")
        Equipped = false
        task.wait(1)
        Root = GetRoot()
    end

    return Root
end

local function TeleportTo(Position)
    local Root = WaitForRoot()

    if not Root then
        return false
    end

    Root.CFrame = CFrame.new(
        Position.X,
        Position.Y + CFG.TeleportHeight,
        Position.Z
    )

    Root.AssemblyLinearVelocity = Vector3.zero

    task.wait(CFG.TeleportDelay)

    return true
end

--==================================================
-- ISLAND
--==================================================

local function GetNodes()
    local Root = GetRoot()

    local Best, BestDistance, Fallback

    for _, Island in ipairs(workspace:GetChildren()) do
        if Island.Name:match("^Island_") then
            local Nodes = Island:FindFirstChild("Nodes")

            if Nodes then
                Fallback = Fallback or Nodes

                if Root then
                    local Kids = Nodes:GetChildren()
                    local Step = math.max(1, math.floor(#Kids / 12))

                    for Index = 1, #Kids, Step do
                        local HB = Kids[Index]:FindFirstChild("HB")

                        if HB and HB:IsA("BasePart") then
                            local Distance =
                                (HB.Position - Root.Position).Magnitude

                            if not BestDistance or Distance < BestDistance then
                                Best = Nodes
                                BestDistance = Distance
                            end
                        end
                    end
                end
            end
        end
    end

    return Best or Fallback
end

--==================================================
-- FLOWER DETECTION
--==================================================

local function IsSnapdragon(Model)
    if not Model:IsA("Model") then
        return false
    end

    return Model.Name:lower():gsub("%s+", "") == CFG.FlowerName
end

local function GetFlowerHB(Model)
    local HB = Model:FindFirstChild("HB", true)

    if HB and HB:IsA("BasePart") then
        return HB
    end

    return nil
end

local function GetFlowers(Nodes)
    local Flowers = {}

    for _, Object in ipairs(Nodes:GetDescendants()) do
        if IsSnapdragon(Object) then
            local HB = GetFlowerHB(Object)

            if HB then
                table.insert(Flowers, {
                    Model = Object,
                    HB = HB,
                    Position = HB.Position,
                })
            end
        end
    end

    return Flowers
end

--==================================================
-- RECORD EXISTING FLOWERS
--==================================================

local function RecordExistingFlowers(Nodes)
    table.clear(SeenFlowers)

    for _, Flower in ipairs(GetFlowers(Nodes)) do
        SeenFlowers[Flower.Model] = true
    end
end

--==================================================
-- FIND PAIRS (ORIGINAL v2.0)
--==================================================

local function FindPairs(Nodes)
    local Flowers = GetFlowers(Nodes)

    local Reach = CFG.GridSize * CFG.MaxCells + 0.6
    local Used = {}
    local Pairs = {}

    for Index, A in ipairs(Flowers) do
        if not Used[A.Model] then
            local Best, BestDistance

            for OtherIndex, B in ipairs(Flowers) do
                if OtherIndex ~= Index and not Used[B.Model] then
                    local DX = math.abs(A.Position.X - B.Position.X)
                    local DZ = math.abs(A.Position.Z - B.Position.Z)
                    local DY = math.abs(A.Position.Y - B.Position.Y)

                    if DX <= Reach
                    and DZ <= Reach
                    and DY <= CFG.HeightTolerance then

                        local Distance = DX * DX + DZ * DZ

                        if Distance > 0
                        and (not BestDistance or Distance < BestDistance) then
                            Best = B
                            BestDistance = Distance
                        end
                    end
                end
            end

            if Best then
                Used[A.Model] = true
                Used[Best.Model] = true

                table.insert(Pairs, {
                    A = A,
                    B = Best,
                    Spot = (A.Position + Best.Position) / 2,
                })
            end
        end
    end

    local Ordered = {}
    local Current = nil

    while #Pairs > 0 do
        local BestIndex, BestDistance = 1, nil

        for Index, Pair in ipairs(Pairs) do
            local Distance =
                Current and (Pair.Spot - Current).Magnitude
                or Pair.Spot.Magnitude

            if not BestDistance or Distance < BestDistance then
                BestIndex = Index
                BestDistance = Distance
            end
        end

        local Pair = table.remove(Pairs, BestIndex)

        table.insert(Ordered, Pair)
        Current = Pair.Spot
    end

    return Ordered
end

--==================================================
-- EQUIP
--==================================================

local function EquipPollinator()
    HoldRemote:FireServer("Pollinator")

    task.wait(CFG.PollinationDelay)

    Equipped = true
end

--==================================================
-- POLLINATE
--==================================================

local function PollinatePair(Pair)
    if not Pair
    or not Pair.A.Model.Parent
    or not Pair.B.Model.Parent
    or not Pair.A.HB.Parent
    or not Pair.B.HB.Parent then
        return false
    end

    if not TeleportTo(Pair.Spot) then
        return false
    end

    PollinateRemote:FireServer(Pair.A.HB, 1)
    task.wait(CFG.PollinationDelay)

    PollinateRemote:FireServer(Pair.B.HB, 2)
    task.wait(CFG.PollinationDelay)

    Stats.Done += 1
    UpdateStats()

    return true
end

--==================================================
-- FIND NEW OFFSPRING
--==================================================

local function FindNewOffspring(Nodes)
    for _, Flower in ipairs(GetFlowers(Nodes)) do
        if not SeenFlowers[Flower.Model] then
            SeenFlowers[Flower.Model] = true
            return Flower
        end
    end

    return nil
end

--==================================================
-- WAIT FOR OFFSPRING
--==================================================

local function WaitForOffspring(Nodes)
    local Started = os.clock()

    UpdateStatus("Waiting for offspring...")

    while Running do
        local NewFlower = FindNewOffspring(Nodes)

        if NewFlower then
            return NewFlower
        end

        if CFG.OffspringTimeout > 0
        and os.clock() - Started >= CFG.OffspringTimeout then
            return nil
        end

        task.wait(CFG.OffspringScanDelay)
    end

    return nil
end

--==================================================
-- HARVEST OFFSPRING
--==================================================

local function HarvestOffspring(Flower)
    if not Flower
    or not Flower.Model
    or not Flower.Model.Parent then
        return false
    end

    local HB = GetFlowerHB(Flower.Model)

    if not HB then
        return false
    end

    UpdateStatus("Harvesting offspring...")

    if not TeleportTo(HB.Position) then
        return false
    end

    task.wait(CFG.HarvestDelay)

    HarvestRemote:FireServer(HB)

    task.wait(CFG.HarvestDelay)

    Stats.Harvested += 1
    UpdateStats()

    return true
end

--==================================================
-- MAIN LOOP
--==================================================

local function Run()
    local Nodes = GetNodes()

    if not Nodes then
        UpdateStatus("Island or Nodes not found")
        Running = false
        return
    end

    -- Record parents before any pollination happens.
    RecordExistingFlowers(Nodes)

    UpdateStatus("Scanning pairs...")

    local Pairs = FindPairs(Nodes)

    Stats.Pairs = #Pairs
    Stats.Rounds = 1
    UpdateStats()

    if #Pairs == 0 then
        UpdateStatus("No Snapdragon pairs found")
        Running = false
        return
    end

    if not Equipped then
        if not WaitForRoot() then
            Running = false
            return
        end

        EquipPollinator()
    end

    -- Initial pass: pollinate every discovered pair.
    for Index, Pair in ipairs(Pairs) do
        if not Running then
            break
        end

        UpdateStatus(("Pollinating pair %d/%d"):format(Index, #Pairs))

        if not Equipped then
            EquipPollinator()
        end

        if PollinatePair(Pair) then
            LastPair = Pair
        end
    end

    -- Continuous offspring cycle.
    while Running and CFG.Loop do
        if not Nodes.Parent then
            UpdateStatus("Island unavailable")
            break
        end

        local Offspring = WaitForOffspring(Nodes)

        if not Running then
            break
        end

        if not Offspring then
            UpdateStatus("Offspring wait timed out")
            break
        end

        if HarvestOffspring(Offspring) then
            -- Return to the last pair that was pollinated.
            if LastPair then
                UpdateStatus("Returning to parent pair...")

                if not Equipped then
                    EquipPollinator()
                end

                if PollinatePair(LastPair) then
                    Stats.Rounds += 1
                    UpdateStats()
                end
            end
        end
    end

    Running = false
    UpdateStatus("Done")
end

--==================================================
-- UI
--==================================================

MainTab:CreateToggle({
    Name = "Auto Pollination",
    CurrentValue = false,
    Flag = "VANTA_AutoPollination",

    Callback = function(Value)
        if Value then
            if Running then
                return
            end

            Running = true
            Equipped = false
            LastPair = nil

            Stats.Pairs = 0
            Stats.Done = 0
            Stats.Harvested = 0
            Stats.Rounds = 0

            UpdateStats()

            task.spawn(Run)
        else
            Running = false
            UpdateStatus("Stopped")
        end
    end,
})

MainTab:CreateToggle({
    Name = "Loop / Auto Offspring",
    CurrentValue = CFG.Loop,
    Flag = "VANTA_Loop",

    Callback = function(Value)
        CFG.Loop = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Pair distance (cells)",
    Range = {1, 4},
    Increment = 1,
    Suffix = " cells",
    CurrentValue = CFG.MaxCells,
    Flag = "VANTA_MaxCells",

    Callback = function(Value)
        CFG.MaxCells = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Grid Size",
    Range = {2, 12},
    Increment = 1,
    Suffix = " studs",
    CurrentValue = CFG.GridSize,
    Flag = "VANTA_GridSize",

    Callback = function(Value)
        CFG.GridSize = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Teleport Height",
    Range = {2, 10},
    Increment = 1,
    Suffix = " studs",
    CurrentValue = CFG.TeleportHeight,
    Flag = "VANTA_TeleportHeight",

    Callback = function(Value)
        CFG.TeleportHeight = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Pollination Delay",
    Range = {0.05, 2},
    Increment = 0.05,
    Suffix = " seconds",
    CurrentValue = CFG.PollinationDelay,
    Flag = "VANTA_PollinationDelay",

    Callback = function(Value)
        CFG.PollinationDelay = Value
    end,
})

SettingsTab:CreateSlider({
    Name = "Teleport Delay",
    Range = {0.05, 1},
    Increment = 0.05,
    Suffix = " seconds",
    CurrentValue = CFG.TeleportDelay,
    Flag = "VANTA_TeleportDelay",

    Callback = function(Value)
        CFG.TeleportDelay = Value
    end,
})

Player.CharacterAdded:Connect(function()
    Equipped = false
end)

Rayfield:Notify({
    Title = "VANTA",
    Content = "Auto Pollination v2.1 loaded.",
    Duration = 5,
})

UpdateStatus("Ready")
