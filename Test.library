--==================================================
-- VANTA | AUTO BREAK STONE (v1.4.0)
-- Targets StoneBrick and StoneBlock
--==================================================

--// RAYFIELD
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/gen2"
))()

--// SERVICES
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

--// PLAYER
local Player = Players.LocalPlayer
local SwingRemote = RS:WaitForChild("Remotes"):WaitForChild("RequestSwing")

--// CONFIG
local CFG = {
    BreakSpeed = 0.2,
    GlideSpeed = 12,
    HoverHeight = 6,
    BreakRange = 15,
    MoveRange = 5,
    HoldForce = 1000000000,
}

--// STATE
local enabled = false
local running = false

local currentTween
local bodyPosition
local bodyGyro
local activeRoot
local activeHumanoid

--// CHARACTER
local function getChar()
    local char = Player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end
    return char, humanoid, root
end

--// FIND ISLAND BLOCKS
local function getBlocks()
    local fallback
    for _, island in ipairs(workspace:GetChildren()) do
        if island.Name:match("^Island_") then
            local blocks = island:FindFirstChild("Blocks")
            if blocks then
                if island.Name:find(tostring(Player.UserId), 1, true) then
                    return blocks
                end
                fallback = fallback or blocks
            end
        end
    end
    return fallback
end

--// VALID BLOCK (NEW FILTER)
local function validBlock(block)
    if not block or not block.Parent then return false end
    local id = block:GetAttribute("BlockId")
    -- Only target StoneBrick and StoneBlock
    return id == "StoneBrick" or id == "StoneBlock"
end

--// BLOCK POSITION
local function blockPosition(block)
    if block:IsA("BasePart") then
        return block.Position
    elseif block:IsA("Model") then
        return block:GetPivot().Position
    end
end

--// NEAREST BLOCK
local function nearestBlock(blocks, root)
    local nearest
    local shortest = math.huge

    for _, block in ipairs(blocks:GetChildren()) do
        if validBlock(block) then
            local pos = blockPosition(block)
            if pos then
                local distance = (root.Position - pos).Magnitude
                if distance < shortest then
                    shortest = distance
                    nearest = block
                end
            end
        end
    end
    return nearest
end

--// START PERMANENT HOVER
local function startHover()
    local _, humanoid, root = getChar()
    if not root or not humanoid then return false end

    if activeRoot == root and bodyPosition and bodyPosition.Parent then
        return true
    end

    if bodyPosition then bodyPosition:Destroy(); bodyPosition = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end

    activeRoot = root
    activeHumanoid = humanoid

    humanoid.AutoRotate = false
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    bodyPosition = Instance.new("BodyPosition")
    bodyPosition.Name = "VANTA_Hover"
    bodyPosition.Position = root.Position + Vector3.new(0, CFG.HoverHeight, 0)
    bodyPosition.MaxForce = Vector3.new(CFG.HoldForce, CFG.HoldForce, CFG.HoldForce)
    bodyPosition.P = 15000
    bodyPosition.D = 1500
    bodyPosition.Parent = root

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Name = "VANTA_HoverRotation"
    bodyGyro.CFrame = root.CFrame
    bodyGyro.MaxTorque = Vector3.new(CFG.HoldForce, CFG.HoldForce, CFG.HoldForce)
    bodyGyro.P = 10000
    bodyGyro.D = 1000
    bodyGyro.Parent = root

    return true
end

--// SMOOTH TWEEN MOVEMENT
local function glideTo(block)
    if not enabled or not block or not block.Parent then return false end

    local _, humanoid, root = getChar()
    if not root or not humanoid then return false end
    if not startHover() then return false end

    local target = blockPosition(block)
    if not target then return false end

    local offset = root.Position - target
    local direction = Vector3.new(offset.X, 0, offset.Z)

    if direction.Magnitude < 0.1 then
        direction = Vector3.new(1, 0, 0)
    else
        direction = direction.Unit
    end

    local destination = target + direction * CFG.MoveRange + Vector3.new(0, CFG.HoverHeight, 0)
    local distance = (bodyPosition.Position - destination).Magnitude
    local duration = math.max(distance / CFG.GlideSpeed, 0.5)

    if currentTween then currentTween:Cancel(); currentTween = nil end

    currentTween = TweenService:Create(
        bodyPosition,
        TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
        { Position = destination }
    )

    currentTween:Play()
    local result = currentTween.Completed:Wait()
    currentTween = nil
    return enabled and result == Enum.PlaybackState.Completed
end

--// BREAK BLOCKS WHILE HOVERING
local function breakNearby(blocks)
    while enabled do
        if not startHover() then return end

        local _, _, root = getChar()
        if not root then return end

        local found = false

        for _, block in ipairs(blocks:GetChildren()) do
            if not enabled then return end

            if validBlock(block) then
                local pos = blockPosition(block)
                if pos and (root.Position - pos).Magnitude <= CFG.BreakRange then
                    found = true
                    pcall(function()
                        SwingRemote:FireServer(block)
                    end)
                    task.wait(CFG.BreakSpeed)
                end
            end
        end

        if not found then break end
        task.wait(0.1)
    end
end

--// CLEANUP
local function stopHover()
    if currentTween then currentTween:Cancel(); currentTween = nil end
    if bodyPosition then bodyPosition:Destroy(); bodyPosition = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end

    if activeHumanoid and activeHumanoid.Parent then
        activeHumanoid.AutoRotate = true
        activeHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    activeRoot = nil
    activeHumanoid = nil
end

--// MAIN LOOP
local function start()
    if running then return end
    running = true

    task.spawn(function()
        while enabled do
            local _, _, root = getChar()
            local blocks = getBlocks()

            if root and blocks then
                startHover()
                local target = nearestBlock(blocks, root)

                if target then
                    local pos = blockPosition(target)
                    if pos then
                        local distance = (root.Position - pos).Magnitude
                        if distance > CFG.BreakRange then
                            glideTo(target)
                        end
                        if enabled then
                            breakNearby(blocks)
                        end
                    end
                else
                    task.wait(0.5)
                end
            else
                task.wait(1)
            end
            task.wait(0.05)
        end
        stopHover()
        running = false
    end)
end

--// UI
local Window = Rayfield:CreateWindow({
    name = "VANTA | CLEAN STONE",
    loadingTitle = "VANTA",
    loadingSubtitle = "by dj",
})

local Tab = Window:CreateTab({
    name = "Cleanup",
})

Tab:CreateToggle({
    name = "Auto Break Stone Walls",
    flag = "AutoBreakStone",
    currentValue = false,
    callback = function(value)
        enabled = value
        if value then
            start()
        else
            stopHover()
        end
    end,
})

Tab:CreateSlider({
    name = "Break Speed",
    flag = "BreakSpeed",
    range = {0.05, 1},
    increment = 0.05,
    suffix = " s",
    currentValue = CFG.BreakSpeed,
    callback = function(value)
        CFG.BreakSpeed = value
    end,
})
